{
  "match": {"sector": "Financial Services"},
  "name": "Financial Services v1.0 - Institutional Grade",
  "analyst_brief": "Analysis based on verified Screener.in data + calculated institutional metrics (NIM, Cost-to-Income). Prioritizes asset quality, capital adequacy, and deposit franchise strength.",
  "metrics": [
    {"metric_name": "ROE", "path": "ratios.ROE %", "direction": "higher", "weight": 3},
    {"metric_name": "Gross NPA", "path": "ratios.Gross NPA %", "direction": "lower", "weight": 3},
    {"metric_name": "Net NPA", "path": "ratios.Net NPA %", "direction": "lower", "weight": 3},
    {"metric_name": "Capital Adequacy", "path": "ratios.Capital adequacy ratio %", "direction": "higher", "weight": 3},
    {"metric_name": "Promoter Holding", "path": "ratios.Promoter holding", "direction": "higher", "weight": 2},
    {"metric_name": "Pledged", "path": "ratios.Pledged %", "direction": "lower", "weight": 3},
    {"metric_name": "P/E", "path": "ratios.Stock P/E", "direction": "lower", "weight": 2},
    {"metric_name": "Price to Book", "path": "ratios.Price to book", "direction": "lower", "weight": 2},
    {"metric_name": "Sales Growth", "path": "CAGRs.Compounded Sales Growth.5 Years", "direction": "higher", "weight": 2},
    {"metric_name": "Profit Growth", "path": "CAGRs.Compounded Profit Growth.5 Years", "direction": "higher", "weight": 2},
    {"metric_name": "Cost to Income", "path": "calc.Cost to Income", "direction": "lower", "weight": 2}
  ]
}

{
  "match": {"sector": "Financial Services"},
  "name": "Financial Services v1.0 - Institutional Grade",
  "analyst_brief": "The Indian financial services ecosystem acts as the central transmission engine for economic expansion. The primary operating paradigm relies on accumulating low-cost CASA deposits and deploying this capital into credit products with robust risk-adjusted returns (NIM). Valuation is heavily dependent on asset quality (GNPA/NNPA) and capital adequacy (CRAR).",
  "key_regulators": ["RBI (Reserve Bank of India)", "IRDAI", "SEBI"],
  "macro_sensitivities": ["Interest Rate Cycle (Repo Rate)", "Credit Growth", "Inflation / Yield Curve"],
  "industry_associations": ["IBA (Indian Banks' Association)", "AMFI"],
  "competitive_landscape": "Highly consolidated. Dominated by large private banks (HDFC, ICICI) and PSUs (SBI). NBFCs compete on risk appetite and speed. AMCs and Insurance are shifting towards passive/index funds and term plans.",
  "red_flags": [
    {"flag": "NPA Divergence", "reason": "RBI frequently finds banks under-provisioning. Check 'RBI divergence' in concalls."},
    {"flag": "Evergreening of Loans", "reason": "Lending to stressed borrowers via AIFs or other NBFCs to avoid NPA classification."},
    {"flag": "High Unsecured Loan Growth", "reason": "RBI has increased risk weights on unsecured consumer credit. High growth here is a red flag for future NPAs."},
    {"flag": "CASA Ratio Decline", "reason": "Indicates rising cost of funds and margin pressure."}
  ],
  "metrics": [
    {"metric_name": "Net Interest Margin (NIM)", "path": "calc.NIM", "direction": "higher", "weight": 3},
    {"metric_name": "CASA Ratio", "path": "ratios.CASA ratio %", "aliases": ["ratios.CASA ratio"], "direction": "higher", "weight": 3},
    {"metric_name": "Credit Cost", "path": "calc.Credit Cost", "direction": "lower", "weight": 3},
    {"metric_name": "Gross NPA", "path": "ratios.GNPA %", "aliases": ["ratios.Gross NPA %"], "direction": "lower", "weight": 3},
    {"metric_name": "Net NPA", "path": "ratios.NNPA %", "aliases": ["ratios.Net NPA %"], "direction": "lower", "weight": 3},
    {"metric_name": "Provision Coverage Ratio", "path": "calc.PCR", "direction": "higher", "weight": 3},
    {"metric_name": "Cost-to-Income Ratio", "path": "calc.Cost to Income", "direction": "lower", "weight": 2},
    {"metric_name": "Capital Adequacy (CRAR)", "path": "ratios.CRAR %", "aliases": ["ratios.Capital adequacy ratio %"], "direction": "higher", "weight": 3},
    {"metric_name": "ROE", "path": "ratios.ROE %", "direction": "higher", "weight": 3},
    {"metric_name": "ROA", "path": "ratios.ROA %", "aliases": ["ratios.Return on assets %"], "direction": "higher", "weight": 3},
    {"metric_name": "Fee Income Ratio", "path": "calc.Fee Income Ratio", "direction": "higher", "weight": 2},
    {"metric_name": "Promoter Holding", "path": "ratios.Promoter holding", "direction": "higher", "weight": 1},
    {"metric_name": "Pledged Shares", "path": "ratios.Pledged %", "direction": "lower", "weight": 3},
    {"metric_name": "Stock P/E", "path": "ratios.Stock P/E", "aliases": ["ratios.P/E"], "direction": "lower", "weight": 2},
    {"metric_name": "Price to Book", "path": "ratios.Price to book", "aliases": ["ratios.P/B"], "direction": "lower", "weight": 2},
    {"metric_name": "Sales Growth", "path": "CAGRs.Compounded Sales Growth", "direction": "higher", "weight": 2},
    {"metric_name": "Profit Growth", "path": "CAGRs.Compounded Profit Growth", "direction": "higher", "weight": 2}
  ]
}
